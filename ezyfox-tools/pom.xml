<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tvd12</groupId>
        <artifactId>ezyfox-versions</artifactId>
        <version>1.3.1</version>
    </parent>
    <artifactId>ezyfox-tools</artifactId>
    <name>ezyfox-tools</name>
    <description>
        Command-line helpers and ancillary utilities for working with EzyFox projects.
    </description>
    <url>https://youngmonkeys.org/projects/ezyfox-library</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git@github.com:youngmonkeys/ezyfox.git</connection>
        <developerConnection>scm:git:git@github.com:youngmonkeys/ezyfox.git</developerConnection>
        <url>https://github.com/youngmonkeys/ezyfox</url>
    </scm>

    <developers>
        <developer>
            <name>Ta Van Dung</name>
            <email>ta.van.dung@youngmonkeys.org</email>
            <organization>Young Monkeys</organization>
            <organizationUrl>https://youngmonkeys.org/</organizationUrl>
        </developer>
    </developers>

    <properties>
        <javax.persistence.version>2.2</javax.persistence.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tvd12</groupId>
            <artifactId>ezyfox-io</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>javax.persistence</groupId>
            <artifactId>javax.persistence-api</artifactId>
            <version>${javax.persistence.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
